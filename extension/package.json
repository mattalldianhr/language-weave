{
  "name": "language-weave-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Language Weave browser extension. No build step; plain ES modules.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser/run.mjs",
    "test:real": "node test/browser/real.mjs",
    "lint:firefox": "npx --yes web-ext lint --source-dir . --ignore-files 'test/**' 'vendor/**' 'dist/**'",
    "build:firefox": "npx --yes web-ext build --source-dir . --artifacts-dir dist --ignore-files 'test/**' 'dist/**' 'seed.json' 'package.json' --overwrite-dest",
    "smoke:firefox": "node test/browser/firefox-smoke.mjs"
  },
  "license": "MIT"
}
